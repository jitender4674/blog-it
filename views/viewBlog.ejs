<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("./partials/head") %>
    <title>Document</title>
</head>
<body>
    <%- include("./partials/navbar") %>
    
    <div class="container mt-4">
        <h1><%= blog.title %></h1>
        <img src="<%= blog.coverImageURL %>" alt="porsche 911 gt3 c" style="width: 50%;">

        <pre class="mt-3" 
        style="white-space: pre-wrap; word-wrap: break-word;"><%= blog.body %>
        </pre>
    </div>



    <div class="container">
        <img src="<%= blog.createdBy.profileImageURL %>" width="60px"> <%= blog.createdBy.fullName %>
    </div>

    <%- include("./partials/script") %>
</body>
</html>